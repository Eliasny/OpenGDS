From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Elias=20Nyk=C3=A4nen?=
 <61413159+Eliasny@users.noreply.github.com>
Date: Fri, 6 Nov 2026 12:32:31 +0000
Subject: [PATCH] fix(pubsub): return the remaining key lifetime as
 TimeToNextKey

GetSecurityKeys computes TimeToNextKey from the SecurityGroup's baseTime,
but on 1.5 baseTime is never set. TimeToNextKey is therefore the
KeyLifetime minus the whole monotonic clock, a large negative value
(about -1.16e13 ms on a Linux host). Part 14, 8.3.2 defines it as the
time before the current key expires.

Set baseTime when the SecurityGroup's key rollover timer starts and on
every rollover, and keep TimeToNextKey between 0 and the KeyLifetime.
Master has the same fix as part of 2745dd876.
---
 src/pubsub/ua_pubsub_ns0_sks.c       |  7 ++++--
 src/pubsub/ua_pubsub_securitygroup.c |  4 ++++
 tests/pubsub/check_pubsub_sks_pull.c | 34 ++++++++++++++++++++++++++++
 3 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/src/pubsub/ua_pubsub_ns0_sks.c b/src/pubsub/ua_pubsub_ns0_sks.c
index 252fefd5e..40e0e48c9 100644
--- a/src/pubsub/ua_pubsub_ns0_sks.c
+++ b/src/pubsub/ua_pubsub_ns0_sks.c
@@ -322,9 +322,12 @@ getSecurityKeysAction(UA_Server *server, const UA_NodeId *sessionId, void *sessi
     UA_DateTime baseTime = sg->baseTime;
     UA_DateTime currentTime = el->dateTime_nowMonotonic(el);
     UA_Duration interval = sg->config.keyLifeTime;
-    UA_Duration timeToNextKey =
+    UA_Duration elapsed =
         (UA_Duration)((currentTime - baseTime) / UA_DATETIME_MSEC);
-    timeToNextKey = interval - timeToNextKey;
+    /* Part 14, 8.3.2: the time before the current key expires, so it lies
+     * between 0 and the KeyLifetime */
+    UA_Duration timeToNextKey = (elapsed < 0.0) ? interval :
+        (elapsed < interval) ? interval - elapsed : 0.0;
     retval = UA_Variant_setScalarCopy(&output[3], &timeToNextKey,
                                       &UA_TYPES[UA_TYPES_DURATION]);
     if(retval != UA_STATUSCODE_GOOD)
diff --git a/src/pubsub/ua_pubsub_securitygroup.c b/src/pubsub/ua_pubsub_securitygroup.c
index 007574910..c952a14a6 100644
--- a/src/pubsub/ua_pubsub_securitygroup.c
+++ b/src/pubsub/ua_pubsub_securitygroup.c
@@ -184,7 +184,10 @@ updateSKSKeyStorage(UA_PubSubManager *psm, UA_SecurityGroup *sg) {
     UA_PubSubKeyStorage_activateKeyToChannelContext(
         psm, UA_NODEID_NULL, sg->securityGroupId);
 
+    /* The new current key starts its KeyLifetime now (TimeToNextKey in
+     * GetSecurityKeys counts from here) */
     UA_EventLoop *el = psm->sc.server->config.eventLoop;
+    sg->baseTime = el->dateTime_nowMonotonic(el);
     el->modifyTimer(el, sg->callbackId, sg->config.keyLifeTime,
                     NULL, UA_TIMERPOLICY_CURRENTTIME);
 
@@ -250,6 +253,7 @@ initializeKeyStorageWithKeys(UA_PubSubManager *psm, UA_SecurityGroup *sg) {
         goto cleanup;
 
     UA_EventLoop *el = psm->sc.server->config.eventLoop;
+    sg->baseTime = el->dateTime_nowMonotonic(el);
     retval = el->addTimer(el, (UA_Callback)updateSKSKeyStorage, psm,
                           sg, sg->config.keyLifeTime, NULL,
                           UA_TIMERPOLICY_CURRENTTIME, &sg->callbackId);
diff --git a/tests/pubsub/check_pubsub_sks_pull.c b/tests/pubsub/check_pubsub_sks_pull.c
index 5deb9f209..19d7895d5 100644
--- a/tests/pubsub/check_pubsub_sks_pull.c
+++ b/tests/pubsub/check_pubsub_sks_pull.c
@@ -375,6 +375,15 @@ START_TEST(getSecuritykeysGoodAndValidOutput) {
     ck_assert(output[4].type == &UA_TYPES[UA_TYPES_DURATION] ||
               output[4].type == &UA_TYPES[UA_TYPES_DOUBLE]);
 
+    /* Part 14, 8.3.2: TimeToNextKey is the time before the current key
+     * expires, so 0 < TimeToNextKey <= KeyLifetime. One second of the 2 s
+     * KeyLifetime has passed. */
+    UA_Duration keyLifeTime = *(UA_Duration *)output[4].data;
+    UA_Duration timeToNextKey = *(UA_Duration *)output[3].data;
+    ck_assert(keyLifeTime == 2000.0);
+    ck_assert_msg(timeToNextKey > 0.0 && timeToNextKey <= 1000.0,
+                  "TimeToNextKey %f", timeToNextKey);
+
     /* epected values */
     UA_String *securityPolicyUri = (UA_String *)output[0].data;
     UA_String expectedUri = UA_STRING(policUri);
@@ -522,6 +531,30 @@ START_TEST(requestPastKey) {
 }
 END_TEST
 
+/* After a rollover, TimeToNextKey counts from the new current key instead
+ * of falling to 0 or below */
+START_TEST(timeToNextKeyAfterRollover) {
+    UA_fakeSleep(2500); /* one rollover at 2 s */
+    UA_Client *sksClient = UA_Client_newForUnitTest();
+    encyrptedclientconnect(sksClient);
+    UA_StatusCode retval =
+        UA_Client_connectUsername(sksClient, "opc.tcp://localhost:4840", "user1", "password");
+    ck_assert_uint_eq(retval, UA_STATUSCODE_GOOD);
+    UA_CallResponse response = callGetSecurityKeys(sksClient, securityGroupId, 0, 0);
+    ck_assert(response.results != NULL);
+    ck_assert_uint_eq(response.results->statusCode, UA_STATUSCODE_GOOD);
+    ck_assert_uint_eq(response.results->outputArgumentsSize, 5);
+    UA_Variant *output = response.results->outputArguments;
+    ck_assert_uint_eq(*(UA_IntegerId *)output[1].data, 2);
+    UA_Duration timeToNextKey = *(UA_Duration *)output[3].data;
+    ck_assert_msg(timeToNextKey > 0.0 && timeToNextKey <= 2000.0,
+                  "TimeToNextKey %f", timeToNextKey);
+    UA_CallResponse_clear(&response);
+    cleanupSessionContext();
+    UA_Client_delete(sksClient);
+}
+END_TEST
+
 START_TEST(requestUnknownStartingTokenId){
     UA_Client *sksClient = UA_Client_newForUnitTest();
     encyrptedclientconnect(sksClient);
@@ -648,6 +681,7 @@ main(void) {
     tcase_add_test(tc_pubsub_sks_pull, requestCurrentKeyWithFutureKeys);
     tcase_add_test(tc_pubsub_sks_pull, requestCurrentKeyOnly);
     tcase_add_test(tc_pubsub_sks_pull, requestPastKey);
+    tcase_add_test(tc_pubsub_sks_pull, timeToNextKeyAfterRollover);
     tcase_add_test(tc_pubsub_sks_pull, requestUnknownStartingTokenId);
     tcase_add_test(tc_pubsub_sks_pull, requestMaxFutureKeys);
     Suite *s = suite_create("PubSub SKS Pull");
