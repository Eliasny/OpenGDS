@@ -1803,7 +1814,8 @@ UA_ServerConfig_addSecurityPolicies_Filestore(UA_ServerConfig *config,
         UA_free(aes128Sha256RsaOaepPolicy);
         aes128Sha256RsaOaepPolicy = NULL;
     } else {
