diff --git a/tests/encryption/check_secure_policies_discovery.c b/tests/encryption/check_secure_policies_discovery.c
new file mode 100644
index 000000000..d68f8afbf
--- /dev/null
+++ b/tests/encryption/check_secure_policies_discovery.c
@@ -0,0 +1,148 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/.
+ */
+
+/* A server configured with UA_ServerConfig_setDefaultWithSecureSecurityPolicies
+ * answers the discovery services over SecurityPolicy#None (Part 4, 5.4.1) but
+ * rejects every other service on a #None SecureChannel. */
+
+#include <open62541/client_config_default.h>
+#include <open62541/plugin/log_stdout.h>
+#include <open62541/server_config_default.h>
+
+#include "client/ua_client_internal.h"
+#include "test_helpers.h"
+
+#include <check.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "certificates.h"
+#include "thread_wrapper.h"
+
+#define ENDPOINT_URL "opc.tcp://localhost:4840"
+
+static UA_Server *server;
+static UA_atomic(uintptr_t) running;
+static THREAD_HANDLE server_thread;
+
+THREAD_CALLBACK(serverloop) {
+    while(UA_atomic_load(&running))
+        UA_Server_run_iterate(server, true);
+    return 0;
+}
+
+static void setup(void) {
+    UA_ByteString certificate = {CERT_DER_LENGTH, CERT_DER_DATA};
+    UA_ByteString privateKey = {KEY_DER_LENGTH, KEY_DER_DATA};
+
+    UA_ServerConfig config;
+    memset(&config, 0, sizeof(UA_ServerConfig));
+    config.logging = UA_Log_Stdout_new(UA_LOGLEVEL_INFO);
+    UA_StatusCode res =
+        UA_ServerConfig_setDefaultWithSecureSecurityPolicies(&config, 4840,
+                                                             &certificate, &privateKey,
+                                                             NULL, 0, NULL, 0, NULL, 0);
+    ck_assert_uint_eq(res, UA_STATUSCODE_GOOD);
+    config.tcpReuseAddr = true;
+    server = UA_Server_newWithConfig(&config);
+    ck_assert(server != NULL);
+
+    UA_atomic_store(&running, true);
+    UA_Server_run_startup(server);
+    THREAD_CREATE(server_thread, serverloop);
+}
+
+/* A client that opens a #None SecureChannel directly, without first selecting
+ * an endpoint from GetEndpoints (the server has no #None endpoint) */
+static UA_Client *
+newNoneClient(void) {
+    UA_Client *client = UA_Client_newForUnitTest();
+    UA_ClientConfig *cc = UA_Client_getConfig(client);
+    cc->endpoint.securityMode = UA_MESSAGESECURITYMODE_NONE;
+    cc->endpoint.securityPolicyUri =
+        UA_STRING_ALLOC("http://opcfoundation.org/UA/SecurityPolicy#None");
+    cc->endpoint.endpointUrl = UA_STRING_ALLOC(ENDPOINT_URL);
+    return client;
+}
+
+static void teardown(void) {
+    UA_atomic_store(&running, false);
+    THREAD_JOIN(server_thread);
+    UA_Server_run_shutdown(server);
+    UA_Server_delete(server);
+}
+
+START_TEST(get_endpoints_over_none) {
+    UA_Client *client = newNoneClient();
+    size_t endpointsSize = 0;
+    UA_EndpointDescription *endpoints = NULL;
+    UA_StatusCode res =
+        UA_Client_getEndpoints(client, ENDPOINT_URL, &endpointsSize, &endpoints);
+    ck_assert_uint_eq(res, UA_STATUSCODE_GOOD);
+    ck_assert_uint_gt(endpointsSize, 0);
+
+    /* Only secure endpoints. Each one carries the server certificate. */
+    for(size_t i = 0; i < endpointsSize; i++) {
+        ck_assert_uint_ne(endpoints[i].securityMode, UA_MESSAGESECURITYMODE_NONE);
+        ck_assert_uint_gt(endpoints[i].serverCertificate.length, 0);
+    }
+    UA_Array_delete(endpoints, endpointsSize, &UA_TYPES[UA_TYPES_ENDPOINTDESCRIPTION]);
+    UA_Client_delete(client);
+}
+END_TEST
+
+START_TEST(find_servers_over_none) {
+    UA_Client *client = newNoneClient();
+    size_t serversSize = 0;
+    UA_ApplicationDescription *servers = NULL;
+    UA_StatusCode res = UA_Client_findServers(client, ENDPOINT_URL, 0, NULL, 0, NULL,
+                                              &serversSize, &servers);
+    ck_assert_uint_eq(res, UA_STATUSCODE_GOOD);
+    ck_assert_uint_gt(serversSize, 0);
+    UA_Array_delete(servers, serversSize, &UA_TYPES[UA_TYPES_APPLICATIONDESCRIPTION]);
+    UA_Client_delete(client);
+}
+END_TEST
+
+START_TEST(create_session_over_none_rejected) {
+    UA_Client *client = newNoneClient();
+    UA_StatusCode res = UA_Client_connectSecureChannel(client, ENDPOINT_URL);
+    ck_assert_uint_eq(res, UA_STATUSCODE_GOOD);
+
+    UA_CreateSessionRequest request;
+    UA_CreateSessionRequest_init(&request);
+    UA_CreateSessionResponse response;
+    UA_CreateSessionResponse_init(&response);
+    __UA_Client_Service(client, &request, &UA_TYPES[UA_TYPES_CREATESESSIONREQUEST],
+                        &response, &UA_TYPES[UA_TYPES_CREATESESSIONRESPONSE]);
+    ck_assert_uint_eq(response.responseHeader.serviceResult,
+                      UA_STATUSCODE_BADSECURITYPOLICYREJECTED);
+    UA_CreateSessionResponse_clear(&response);
+
+    UA_Client_disconnect(client);
+    UA_Client_delete(client);
+}
+END_TEST
+
+static Suite *testSuite(void) {
+    Suite *s = suite_create("Secure SecurityPolicies with discovery over #None");
+    TCase *tc = tcase_create("Discovery");
+    tcase_add_checked_fixture(tc, setup, teardown);
+    tcase_add_test(tc, get_endpoints_over_none);
+    tcase_add_test(tc, find_servers_over_none);
+    tcase_add_test(tc, create_session_over_none_rejected);
+    suite_add_tcase(s, tc);
+    return s;
+}
+
+int main(void) {
+    Suite *s = testSuite();
+    SRunner *sr = srunner_create(s);
+    srunner_set_fork_status(sr, CK_NOFORK);
+    srunner_run_all(sr, CK_NORMAL);
+    int number_failed = srunner_ntests_failed(sr);
+    srunner_free(sr);
+    return (number_failed == 0) ? EXIT_SUCCESS : EXIT_FAILURE;
+}
