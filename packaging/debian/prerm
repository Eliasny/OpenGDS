#!/bin/sh
# opengds prerm: stop the service before its files go away.
# SPDX-License-Identifier: MPL-2.0
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl stop opengds.service opengds-signer.socket || true
    systemctl disable opengds.service opengds-signer.socket || true
fi
exit 0
