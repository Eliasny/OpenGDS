# OpenGDS Global Discovery Server (opengdsd). The CA key lives in
# opengds-signer@.service under its own user; opengdsd reaches it only
# through opengds-signer.socket (signer_socket in opengds.conf) and never
# sees the CA passphrase.
# SPDX-License-Identifier: MPL-2.0
[Unit]
Description=OpenGDS OPC UA Global Discovery Server
Documentation=https://github.com/Eliasny/OpenGDS
After=network-online.target opengds-signer.socket
Wants=network-online.target
Requires=opengds-signer.socket

[Service]
Type=simple
User=opengds
ExecStart=/usr/bin/opengdsd --config /etc/opengds/opengds.conf
# The store is group-readable (group opengds) so the signer, whose user
# opengds-ca is in that group, can re-read every request it signs.
Group=opengds
StateDirectory=opengds
StateDirectoryMode=0750
ConfigurationDirectory=opengds
# root:opengds 0750, as the package's post-install script creates it
ConfigurationDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=2s

# Hardening (systemd-analyze security opengds.service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
# AF_NETLINK: getifaddrs, which the mDNS announce (mdns = true, OPC 10000-12
# Annex C) uses for the host's addresses; without it no A records go out.
# An unprivileged netlink socket can only read the interface list.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
# @sandbox (landlock_*, seccomp): the process sandboxes itself further
# (src/common/sandbox.c); without it libseccomp cannot probe the kernel and
# refuses the filter, and Landlock looks absent.
SystemCallFilter=@system-service @sandbox
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
