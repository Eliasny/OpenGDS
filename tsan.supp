# ThreadSanitizer suppressions for the CI tsan job.
# open62541 v1.5.10: the timer mutex is always taken inside the event loop
# mutex, so these lock-order reports cannot deadlock (docs/spikes/02).
# Re-check when the open62541 pin moves.
deadlock:UA_Timer_add
deadlock:UA_Timer_process
# GLib (desktop UI view-model tests, avm/): GLib is not built with TSan and
# syncs its worker thread (gmain) with futex-based GMutex, which TSan cannot
# see, so its own malloc/free pairs show as races. GIO's thread pool (the
# blocking pipe reads behind g_subprocess_communicate_async) syncs the same
# way, so its read/close of one fd shows as a race. Our code stays checked.
called_from_lib:libglib-2.0.so.0
called_from_lib:libgio-2.0.so.0
# glibc: mktime() re-reads the time zone (tzset_internal frees and strdups
# its saved TZ) under glibc's own tzset_lock, which TSan cannot see because
# libc is not instrumented. open62541's stdout logger calls mktime through
# UA_DateTime_localTimeUtcOffset on every line, so a server thread and a
# client logging in the same process (unit_disc_mdns) report it as a race.
race:tzset_internal
