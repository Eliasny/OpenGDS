# OpenGDS Auditor - the ConformanceUnit of each test, from the test catalogue
# (docs/auditor/catalogue.csv), as a C table for the report writers. Runs at
# configure time; CMake configures again when the catalogue changes.
# SPDX-License-Identifier: MPL-2.0
set(_ga_csv "${CMAKE_SOURCE_DIR}/docs/auditor/catalogue.csv")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_ga_csv}")
# no field needs ";", which is CMake's list separator
file(READ "${_ga_csv}" _ga_text)
string(REPLACE ";" ":" _ga_text "${_ga_text}")
string(REPLACE "\r" "" _ga_text "${_ga_text}")
string(REPLACE "\n" ";" _ga_lines "${_ga_text}")
list(POP_FRONT _ga_lines _ga_header)
string(REPLACE "," ";" _ga_cols "${_ga_header}")
list(FIND _ga_cols "id" _ga_id_col)
list(FIND _ga_cols "conformance_unit" _ga_cu_col)
if(_ga_id_col LESS 0 OR _ga_cu_col LESS 0)
  message(FATAL_ERROR "${_ga_csv}: no id or conformance_unit column")
endif()
set(_ga_rows "")
foreach(_ga_line IN LISTS _ga_lines)
  if(_ga_line STREQUAL "")
    continue()
  endif()
  # quoted fields (clauses) hold commas; neither id nor the unit is quoted
  string(REGEX REPLACE "\"[^\"]*\"" "Q" _ga_flat "${_ga_line}")
  string(REPLACE "," ";" _ga_fields "${_ga_flat}")
  list(GET _ga_fields ${_ga_id_col} _ga_id)
  list(GET _ga_fields ${_ga_cu_col} _ga_cu)
  if(NOT _ga_id MATCHES "^[A-Za-z0-9._-]+$" OR NOT _ga_cu MATCHES "^[A-Za-z0-9 .()/-]+$")
    message(FATAL_ERROR "${_ga_csv}: cannot read id/conformance_unit in: ${_ga_line}")
  endif()
  string(APPEND _ga_rows "    {\"${_ga_id}\", \"${_ga_cu}\"},\n")
endforeach()
set(GA_CU_TABLE_C "${CMAKE_CURRENT_BINARY_DIR}/ga_cu_table.c")
file(CONFIGURE OUTPUT "${GA_CU_TABLE_C}" @ONLY CONTENT
"/* Generated by tools/auditor/cu_table.cmake from docs/auditor/catalogue.csv:
 * do not edit. SPDX-License-Identifier: MPL-2.0 */
#include \"cu.h\"

const ga_cu_row ga_cu_table[] = {
${_ga_rows}};
const size_t ga_cu_table_len = sizeof(ga_cu_table) / sizeof(ga_cu_table[0]);
")
